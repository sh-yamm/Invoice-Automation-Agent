# Copy to .env and fill in. Get a key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

MODEL_PARSE=nvidia/nemotron-3.5-parse
PARSE_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/nemotron-3.5-parse/parse
MODEL_EXTRACT_TEXT=nvidia/nemotron-3-ultra-550b-a55b
MODEL_EXTRACT=mistralai/mistral-large-4-1t-a52b
MODEL_AGENT=nvidia/nemotron-3-ultra-550b-a55b
MODEL_FAST=nvidia/nemotron-3-ultra-550b-a55b
MODEL_EMBED=nvidia/nemotron-3.5-embed-1b

LLM_MAX_RPM=35
